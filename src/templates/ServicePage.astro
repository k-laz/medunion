---
import { city } from '../data/city';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageHead from '../components/PageHead.astro';
import PriceList from '../components/PriceList.astro';
import { currentPrices } from '../lib/prices';
import DoctorCard from '../components/DoctorCard.astro';
import SearchBox from '../components/SearchBox.astro';
import { childrenOf, tileLabel, shortTeaser, leadText, shortName, doctorsByIds } from '../lib/content';
import { integrations, phones, bookingPage } from '../data/site';
import { saleInfo as loadSaleInfo } from '../lib/sales';
import type { SaleInfo } from '../data/sales';
const saleInfo = await loadSaleInfo();
import { serviceArticles } from '../data/service-extras';

interface Props { entry: CollectionEntry<'services'> }
const { entry } = Astro.props;
const d = entry.data;
const prices = currentPrices(d.prices);
const { Content } = await render(entry);
const hasText = (entry.body ?? '').trim().length > 0;
// (a doctor hidden at /admin/ is not in the collection: skip)
const doctors = await doctorsByIds(d.doctors);
const allServices = await getCollection('services');
const children = childrenOf(d.url, allServices);
const related = d.related.map((u) => allServices.find((x) => x.data.url === u)).filter((x) => x !== undefined);
const bookingUrl = bookingPage; // our /appointment/ page

// /uslugi/ is the catalog: every section with its services, plus search.
const isCatalog = d.url === '/uslugi/';
const ORDER = ['/uslugi/diagnostika/', '/uslugi/centr/', '/uslugi/pediatriya1/', '/uslugi/vyezd-vracha-na-dom/', '/uslugi/klinika-blokady-boli/', '/uslugi/proczedurnyj-kabinet/', '/uslugi/ortopediya-/'];
const rank = (u: string) => (ORDER.indexOf(u) === -1 ? 99 : ORDER.indexOf(u));
const catalog = isCatalog
  ? children
      .sort((a, b) => rank(a.data.url) - rank(b.data.url))
      .map((sec) => ({ sec, items: childrenOf(sec.data.url, allServices).sort((a, b) => shortName(a.data.url, a.data.h1).localeCompare(shortName(b.data.url, b.data.h1), 'ru')) }))
  : [];

const tabs = isCatalog ? [] : [
  children.length && { id: 'sub', label: 'Услуги раздела' },
  prices.length && { id: 'prices', label: 'Цены' },
  doctors.length && { id: 'doctors', label: 'Врачи' },
  hasText && { id: 'about', label: 'Описание' },
  d.faq.length && { id: 'faq', label: 'Вопросы' },
].filter(Boolean) as { id: string; label: string }[];

// Context links under the title, only where they apply: an offer for this
// service (from the offers' own links) and an article on how to prepare or
// what the test is. Pages without either show nothing extra.
const covers = (key: string) => d.url === key || d.url.startsWith(key);
const offerEntries = await getCollection('articles', (a) => a.data.kind === 'sale');
// most specific first: an offer for this exact page beats one for the whole section
const fit = (info: SaleInfo) => Math.max(0, ...(info.links ?? []).filter((l) => covers(l.url)).map((l) => l.url.length));
const offers = Object.entries(saleInfo)
  .filter(([, info]) => fit(info) > 0)
  .sort(([, a], [, b]) => fit(b) - fit(a))
  .map(([url, info]) => {
    const o = offerEntries.find((e) => e.data.url === url);
    const badge = info.badge ?? (o && 'discount' in o.data && o.data.discount ? `−${o.data.discount}` : undefined);
    return { url, badge, title: info.title ?? o?.data.h1 ?? '' };
  })
  .slice(0, 2);
const articleKeys = Object.keys(serviceArticles).filter(covers).sort((x, y) => y.length - x.length);
const readUrls = articleKeys.length ? serviceArticles[articleKeys[0]] : [];
const allArticles = readUrls.length ? await getCollection('articles') : [];
const reads = readUrls
  .map((r) => ({ ...r, title: allArticles.find((a) => a.data.url === r.url)?.data.h1 }))
  .filter((r) => r.title);
---

{isCatalog ? (
  <PageHead url={d.url} h1={d.h1} lead="Диагностика, приём врачей и процедуры для взрослых и детей в трёх клиниках.">
    <SearchBox id="q-catalog" large placeholder="Найти услугу или врача" />
  </PageHead>
) : (
  <PageHead url={d.url} h1={d.h1} lead={d.lead ?? (d.teaser ? leadText(d.teaser) : undefined)}>
    {(offers.length > 0 || reads.length > 0) && (
      <div class="context-links">
        {offers.map((o) => (
          <a class="context-link context-offer" href={o.url}>
            {o.badge && <span class="context-badge">{o.badge}</span>}
            <span>{o.title}</span>
          </a>
        ))}
        {reads.map((r) => (
          <a class="context-link" href={r.url}>
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2zM4 19V5"/></svg>
            <span>{r.prep ? 'Как подготовиться' : 'Статья'}: {r.title}</span>
          </a>
        ))}
      </div>
    )}
    <div class="cta-row cta-booking">
      <a class="btn btn-primary" href={bookingUrl}>Записаться</a>
      <a class="btn btn-quiet btn-phone" href={`tel:${city.phone.tel}`}><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>{city.phone.display}</a>
    </div>
  </PageHead>
)}

{tabs.length > 1 && (
  <nav class="tabs" aria-label="Разделы страницы">
    <div class="wrap tabs-row">{tabs.map((t) => <a href={`#${t.id}`}>{t.label}</a>)}</div>
  </nav>
)}

<div class="wrap page-body">
  <div class="page-main">
  {isCatalog && (
    <div class="catalog">
      {catalog.map(({ sec, items }) => (
        <section class="catalog-group">
          <h2><a href={sec.data.url}>{shortName(sec.data.url, sec.data.h1)}</a></h2>
          {items.length > 0 && <ul>{items.map((i) => <li><a href={i.data.url}>{shortName(i.data.url, i.data.h1)}</a></li>)}</ul>}
        </section>
      ))}
    </div>
  )}

  {!isCatalog && children.length > 0 && (
    <section id="sub" class="block">
      <h2>Услуги раздела</h2>
      <ul class="tile-grid">
        {children.map((c) => (
          <li><a class="tile" href={c.data.url}><span class="tile-text"><span class="tile-title">{shortName(c.data.url, c.data.h1)}</span>{c.data.teaser && <span class="tile-teaser">{shortTeaser(c.data.teaser)}</span>}</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></a></li>
        ))}
      </ul>
    </section>
  )}

  {prices.length > 0 && (
    <section id="prices" class="block">
      <h2>Цены</h2>
      <PriceList items={prices} checkedOn={d.pricesCheckedOn} />
    </section>
  )}

  {doctors.length > 0 && (
    <section id="doctors" class="block">
      <h2>Врачи</h2>
      <div class="doctor-grid">
        {doctors.map((doc) => (
          <DoctorCard name={doc.data.name} specialty={doc.data.specialty} url={doc.data.url} photo={doc.data.photo} experienceYears={doc.data.experienceYears} clinicKeys={doc.data.clinics} />
        ))}
      </div>
    </section>
  )}

  {hasText && (
    <section id="about" class="block">
      <h2 class="sr-only">Описание</h2>
      <div class="clamp" data-clamp>
        <div class="prose"><Content /></div>
      </div>
      <button class="more-btn" type="button" data-clamp-toggle hidden>Показать полностью</button>
    </section>
  )}

  {related.length > 0 && (
    <section class="block">
      <h2>Смотрите также</h2>
      <ul class="tile-grid">
        {related.map((c) => (
          <li><a class="tile" href={c.data.url}><span class="tile-text"><span class="tile-title">{shortName(c.data.url, c.data.h1)}</span>{c.data.teaser && <span class="tile-teaser">{shortTeaser(c.data.teaser)}</span>}</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></a></li>
        ))}
      </ul>
    </section>
  )}

  {d.faq.length > 0 && (
    <section id="faq" class="block faq">
      <h2>Частые вопросы</h2>
      {d.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>
  )}
  </div>
</div>

<script>
  // Long descriptions start folded, like a "read more". The full text is
  // always in the page for search engines and screen readers.
  for (const box of document.querySelectorAll<HTMLElement>('[data-clamp]')) {
    const btn = box.parentElement!.querySelector<HTMLButtonElement>('[data-clamp-toggle]')!;
    if (box.scrollHeight < 640) continue;
    box.classList.add('clamp-on');
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const open = box.classList.toggle('clamp-open');
      btn.textContent = open ? 'Свернуть' : 'Показать полностью';
    });
  }
</script>
