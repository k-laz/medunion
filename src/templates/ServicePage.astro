---
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import PageHead from '../components/PageHead.astro';
import PriceList from '../components/PriceList.astro';
import DoctorCard from '../components/DoctorCard.astro';
import SearchBox from '../components/SearchBox.astro';
import { childrenOf, tileLabel, shortTeaser, leadText, shortName, rub } from '../lib/content';
import { integrations, phones, bookingPage, clinics } from '../data/site';

interface Props { entry: CollectionEntry<'services'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hasText = (entry.body ?? '').trim().length > 0;
const doctors = d.doctors.length ? await getEntries(d.doctors) : [];
const allServices = await getCollection('services');
const children = childrenOf(d.url, allServices);
const related = d.related.map((u) => allServices.find((x) => x.data.url === u)).filter((x) => x !== undefined);
const bookingUrl = bookingPage; // our /appointment/ page

// /uslugi/ is the catalog: every section with its services, plus search.
const isCatalog = d.url === '/uslugi/';
const ORDER = ['/uslugi/diagnostika/', '/uslugi/centr/', '/uslugi/pediatriya1/', '/uslugi/vyezd-vracha-na-dom/', '/uslugi/klinika-blokady-boli/', '/uslugi/proczedurnyj-kabinet/', '/uslugi/ortopediya-/'];
const rank = (u: string) => (ORDER.indexOf(u) === -1 ? 99 : ORDER.indexOf(u));
const catalog = isCatalog
  ? children
      .sort((a, b) => rank(a.data.url) - rank(b.data.url))
      .map((sec) => ({ sec, items: childrenOf(sec.data.url, allServices).sort((a, b) => shortName(a.data.url, a.data.h1).localeCompare(shortName(b.data.url, b.data.h1), 'ru')) }))
  : [];

const tabs = isCatalog ? [] : [
  children.length && { id: 'sub', label: 'Услуги раздела' },
  d.prices.length && { id: 'prices', label: 'Цены' },
  doctors.length && { id: 'doctors', label: 'Врачи' },
  hasText && { id: 'about', label: 'Описание' },
  d.faq.length && { id: 'faq', label: 'Вопросы' },
].filter(Boolean) as { id: string; label: string }[];

// Key facts under the title, all taken from the page's own data:
// the lowest price, how many doctors, where it is done.
const subtree = allServices.filter((x) => x.data.url.startsWith(d.url));
const ownFrom = d.prices.length ? Math.min(...d.prices.map((p) => p.price)) : 0;
const subPrices = subtree.flatMap((x) => x.data.prices);
const subFrom = !ownFrom && subPrices.length ? Math.min(...subPrices.map((p) => p.price)) : 0;
const doctorCount = new Set(subtree.flatMap((x) => x.data.doctors.map((r) => r.id))).size;
const plural = (n: number, one: string, few: string, many: string) => (n % 10 === 1 && n % 100 !== 11 ? one : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? few : many);
const facts = isCatalog ? [] : ([
  ownFrom && { label: 'Стоимость', value: `от ${rub(ownFrom)}`, href: '#prices' },
  subFrom && { label: 'Услуги раздела', value: `от ${rub(subFrom)}`, href: '#sub' },
  doctorCount && { label: 'Врачи', value: `${doctorCount} ${plural(doctorCount, 'врач', 'врача', 'врачей')}`, href: doctors.length ? '#doctors' : undefined },
  d.clinics.length && { label: d.clinics.length > 1 ? 'Клиники' : 'Клиника', value: d.clinics.map((k) => clinics[k].short).join(', ') },
].filter(Boolean) as { label: string; value: string; href?: string }[]);
---

{isCatalog ? (
  <PageHead url={d.url} h1={d.h1} lead="Диагностика, приём врачей и процедуры для взрослых и детей в трёх клиниках.">
    <SearchBox id="q-catalog" large placeholder="Найти услугу или врача" />
  </PageHead>
) : (
  <PageHead url={d.url} h1={d.h1} lead={d.lead ?? (d.teaser ? leadText(d.teaser) : undefined)}>
    {facts.length > 0 && (
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.label}</dt>
            <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
          </div>
        ))}
      </dl>
    )}
    <div class="cta-row">
      <a class="btn btn-primary" href={bookingUrl}>Записаться</a>
      <a class="btn btn-quiet btn-phone" href={`tel:${phones.main.tel}`}>{phones.main.display}</a>
    </div>
  </PageHead>
)}

{tabs.length > 1 && (
  <nav class="tabs" aria-label="Разделы страницы">
    <div class="wrap tabs-row">{tabs.map((t) => <a href={`#${t.id}`}>{t.label}</a>)}</div>
  </nav>
)}

<div class="wrap page-body">
  <div class="page-main">
  {isCatalog && (
    <div class="catalog">
      {catalog.map(({ sec, items }) => (
        <section class="catalog-group">
          <h2><a href={sec.data.url}>{shortName(sec.data.url, sec.data.h1)}</a></h2>
          {items.length > 0 && <ul>{items.map((i) => <li><a href={i.data.url}>{shortName(i.data.url, i.data.h1)}</a></li>)}</ul>}
        </section>
      ))}
    </div>
  )}

  {!isCatalog && children.length > 0 && (
    <section id="sub" class="block">
      <h2>Услуги раздела</h2>
      <ul class="tile-grid">
        {children.map((c) => (
          <li><a class="tile" href={c.data.url}><span class="tile-text"><span class="tile-title">{shortName(c.data.url, c.data.h1)}</span>{c.data.teaser && <span class="tile-teaser">{shortTeaser(c.data.teaser)}</span>}</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></a></li>
        ))}
      </ul>
    </section>
  )}

  {d.prices.length > 0 && (
    <section id="prices" class="block">
      <h2>Цены</h2>
      <PriceList items={d.prices} checkedOn={d.pricesCheckedOn} />
    </section>
  )}

  {doctors.length > 0 && (
    <section id="doctors" class="block">
      <h2>Врачи</h2>
      <div class="doctor-grid">
        {doctors.map((doc) => (
          <DoctorCard name={doc.data.name} specialty={doc.data.specialty} url={doc.data.url} photo={doc.data.photo} experienceYears={doc.data.experienceYears} clinicKeys={doc.data.clinics} />
        ))}
      </div>
    </section>
  )}

  {hasText && (
    <section id="about" class="block">
      <h2 class="sr-only">Описание</h2>
      <div class="clamp" data-clamp>
        <div class="prose"><Content /></div>
      </div>
      <button class="more-btn" type="button" data-clamp-toggle hidden>Показать полностью</button>
    </section>
  )}

  {related.length > 0 && (
    <section class="block">
      <h2>Смотрите также</h2>
      <ul class="tile-grid">
        {related.map((c) => (
          <li><a class="tile" href={c.data.url}><span class="tile-text"><span class="tile-title">{shortName(c.data.url, c.data.h1)}</span>{c.data.teaser && <span class="tile-teaser">{shortTeaser(c.data.teaser)}</span>}</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></a></li>
        ))}
      </ul>
    </section>
  )}

  {d.faq.length > 0 && (
    <section id="faq" class="block faq">
      <h2>Частые вопросы</h2>
      {d.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>
  )}
  </div>
</div>

<script>
  // Long descriptions start folded, like a "read more". The full text is
  // always in the page for search engines and screen readers.
  for (const box of document.querySelectorAll<HTMLElement>('[data-clamp]')) {
    const btn = box.parentElement!.querySelector<HTMLButtonElement>('[data-clamp-toggle]')!;
    if (box.scrollHeight < 640) continue;
    box.classList.add('clamp-on');
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const open = box.classList.toggle('clamp-open');
      btn.textContent = open ? 'Свернуть' : 'Показать полностью';
    });
  }
</script>
