---
// Articles, offers, news and plain pages (about, legal...).
// Articles and offers get the booking card in a right-hand column; articles
// also get the doctors of the related service and more articles on the topic.
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import InfoCard from '../components/InfoCard.astro';
import DoctorCard from '../components/DoctorCard.astro';
import { sales as saleInfo } from '../data/sales';
import { articleService } from '../data/articles';
import { childrenOf, shortName } from '../lib/content';
import { currentPrices } from '../lib/prices';

interface Props { entry: CollectionEntry<'articles'> | CollectionEntry<'pages'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const isPost = 'kind' in d;
const isSale = isPost && d.kind === 'sale';
const isArticle = isPost && d.kind === 'article';
const hasText = (entry.body ?? '').trim().length > 0;
const offerLinks = isSale ? saleInfo[d.url]?.links ?? [] : [];
const badge = isSale ? saleInfo[d.url]?.badge ?? ('discount' in d && d.discount ? `−${d.discount}` : undefined) : undefined;
// Section pages (e.g. /pacientam/): list the pages inside them
const subpages = isPost ? [] : childrenOf(d.url, await getCollection('pages')).sort((a, b) => a.data.h1.localeCompare(b.data.h1, 'ru'));

// Article: the related service, its prices (the section and everything in it),
// its doctors, and other articles of the same category.
let service: CollectionEntry<'services'> | undefined;
let servicePrices: { name: string; price: number }[] = [];
let doctors: CollectionEntry<'doctors'>[] = [];
let moreArticles: CollectionEntry<'articles'>[] = [];
if (isArticle) {
  const category = 'category' in d ? d.category : undefined;
  const serviceUrl = category ? articleService[category] : undefined;
  const services = await getCollection('services');
  service = services.find((s) => s.data.url === serviceUrl);
  if (service) {
    const subtree = services.filter((s) => s.data.url.startsWith(service!.data.url));
    servicePrices = currentPrices(subtree.flatMap((s) => s.data.prices));
    const refs = [...new Map(subtree.flatMap((s) => s.data.doctors).map((r) => [r.id, r])).values()];
    doctors = (await getEntries(refs)).sort((a, b) => a.data.name.localeCompare(b.data.name, 'ru')).slice(0, 3);
  }
  const same = (await getCollection('articles', (a) => a.data.kind === 'article' && 'category' in a.data && a.data.category === category))
    .sort((a, b) => a.data.h1.localeCompare(b.data.h1, 'ru'));
  const i = same.findIndex((a) => a.id === entry.id);
  moreArticles = [...same.slice(i + 1), ...same.slice(0, i)].slice(0, 3); // the next three, wrapping around
}
const withAside = isArticle || isSale;
const saleNote = isSale
  ? saleInfo[d.url]?.group === 'social'
    ? 'Скажите администратору, что записываетесь со скидкой, и возьмите с собой подтверждающий документ.'
    : 'Скажите администратору, что записываетесь по акции.'
  : undefined;
const arrow = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>';
---

<PageHead url={d.url} h1={d.h1} compact>
  {'date' in d && d.date && (
    <p class="offer-meta"><time datetime={d.date.toISOString().slice(0, 10)}>{d.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>
  )}
  {isSale && (badge || d.period) && (
    <p class="offer-meta">
      {badge && <span class="offer-badge">{badge}</span>}
      {d.period && <span>Действует {d.period}</span>}
    </p>
  )}
</PageHead>

<div class:list={['wrap', 'page-body', { 'with-aside': withAside }]}>
  <div class="page-main">
    {subpages.length > 0 && (
      <ul class="tile-grid tile-grid-2 subpages">
        {subpages.map((p) => <li><a class="tile" href={p.data.url}><span>{p.data.h1}</span><Fragment set:html={arrow} /></a></li>)}
      </ul>
    )}
    {hasText && (
      <article class="prose block">
        <Content />
      </article>
    )}
    {offerLinks.length > 0 && (
      <section class="block">
        <h2>Подробнее об услугах</h2>
        <ul class="tile-grid">
          {offerLinks.map((l) => <li><a class="tile" href={l.url}><span>{l.label}</span><Fragment set:html={arrow} /></a></li>)}
        </ul>
      </section>
    )}
    {doctors.length > 0 && (
      <section class="block">
        <h2>Врачи по теме</h2>
        <div class="doctor-grid">
          {doctors.map((doc) => (
            <DoctorCard name={doc.data.name} specialty={doc.data.specialty} url={doc.data.url} photo={doc.data.photo} experienceYears={doc.data.experienceYears} clinicKeys={doc.data.clinics} />
          ))}
        </div>
      </section>
    )}
    {isPost && !withAside && <CtaBand title="Есть вопросы по теме?" text="Запишитесь на приём к врачу или позвоните нам." />}
    {moreArticles.length > 0 && (
      <section class="block">
        <h2>Читайте также</h2>
        <ul class="tile-grid">
          {moreArticles.map((a) => <li><a class="tile" href={a.data.url}><span>{a.data.h1}</span><Fragment set:html={arrow} /></a></li>)}
        </ul>
      </section>
    )}
  </div>

  {withAside && (
    <div class="page-aside">
      {isSale && <InfoCard heading="Записаться по акции" note={saleNote} />}
      {isArticle && (
        service
          ? <InfoCard heading="Запись к врачу" service={{ label: shortName(service.data.url, service.data.h1), url: service.data.url }} prices={servicePrices} clinicKeys={service.data.clinics} places={false} />
          : <InfoCard heading="Запись к врачу" places={false} />
      )}
    </div>
  )}
</div>

