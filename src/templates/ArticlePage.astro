---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { sales as saleInfo } from '../data/sales';

interface Props { entry: CollectionEntry<'articles'> | CollectionEntry<'pages'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const isArticle = 'kind' in d;
const isSale = isArticle && d.kind === 'sale';
const related = isSale ? saleInfo[d.url]?.links ?? [] : [];
const badge = isSale ? saleInfo[d.url]?.badge ?? ('discount' in d && d.discount ? `−${d.discount}` : undefined) : undefined;
// Section pages (e.g. /pacientam/): list the pages inside them
import { childrenOf } from '../lib/content';
const subpages = isArticle ? [] : childrenOf(d.url, await getCollection('pages')).sort((a, b) => a.data.h1.localeCompare(b.data.h1, 'ru'));
---

<PageHead url={d.url} h1={d.h1} compact>
  {'date' in d && d.date && (
    <p class="offer-meta"><time datetime={d.date.toISOString().slice(0, 10)}>{d.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>
  )}
  {isSale && (badge || d.period) && (
    <p class="offer-meta">
      {badge && <span class="offer-badge">{badge}</span>}
      {d.period && <span>Действует {d.period}</span>}
    </p>
  )}
</PageHead>

<div class="wrap page-body">
  {subpages.length > 0 && (
    <ul class="tile-grid tile-grid-2 subpages">
      {subpages.map((p) => <li><a class="tile" href={p.data.url}><span>{p.data.h1}</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></a></li>)}
    </ul>
  )}
  {(entry.body ?? '').trim() && (
    <article class="prose block">
      <Content />
    </article>
  )}
  {related.length > 0 && (
    <section class="block">
      <h2>Подробнее об услугах</h2>
      <ul class="tile-grid">
        {related.map((l) => <li><a class="tile" href={l.url}><span>{l.label}</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></a></li>)}
      </ul>
    </section>
  )}
  {isSale && <CtaBand title="Записаться по акции" text={saleInfo[d.url]?.group === 'social' ? 'Скажите администратору, что записываетесь со скидкой, и возьмите с собой подтверждающий документ.' : 'Скажите администратору, что записываетесь по акции.'} />}
  {isArticle && !isSale && <CtaBand title="Есть вопросы по теме?" text="Запишитесь на приём к врачу онлайн или по телефону." />}
</div>
