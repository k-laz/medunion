---
import { render, type CollectionEntry } from 'astro:content';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props { entry: CollectionEntry<'articles'> | CollectionEntry<'pages'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const isArticle = 'kind' in d;
---

<PageHead url={d.url} h1={d.h1} compact />

<div class="wrap page-body">
  <article class="prose block">
    <Content />
  </article>
  {isArticle && <CtaBand title="Есть вопросы по теме?" text="Запишитесь на приём к врачу онлайн или по телефону." />}
</div>
