---
import type { CollectionEntry } from 'astro:content';
import PageHead from '../components/PageHead.astro';
import { clinics, integrations, type ClinicKey, bookingPage } from '../data/site';

interface Props { entry: CollectionEntry<'pages'> }
const d = Astro.props.entry.data;
const keys: ClinicKey[] = d.layout === 'clinic' && d.clinic ? [d.clinic] : (Object.keys(clinics) as ClinicKey[]);
const pageFor: Record<ClinicKey, string> = {
  kurchatova: '/contacts/klinika-na-kurchatova/',
  instrumentalnaya: '/contacts/klinika-na-instrumentalnoy/',
  kansk: '/contacts/klinika-v-kanske/',
};
const mapUrl = (k: ClinicKey) => `https://yandex.ru/maps/?text=${encodeURIComponent(`${clinics[k].city}, ${clinics[k].address}, Медюнион`)}`;
const bookingUrl = bookingPage; // our /appointment/ page
---

<PageHead url={d.url} h1={d.h1} compact />

<div class="wrap page-body">
  <div class="clinic-grid block">
    {keys.map((k) => {
      const c = clinics[k];
      return (
        <section class="clinic-card">
          <p class="clinic-city">{c.city}</p>
          <h2>{d.layout === 'clinic' ? c.address : <a href={pageFor[k]}>{c.address}</a>}</h2>
          {c.district && <p class="muted">{c.district}</p>}
          <ul class="hours">{c.hours.map((h) => <li>{h}</li>)}</ul>
          <p class="clinic-phone"><a href={`tel:${c.phone.tel}`}>{c.phone.display}</a></p>
          <div class="cta-row">
            <a class="btn btn-quiet" href={mapUrl(k)} target="_blank" rel="noopener">Как добраться</a>
          </div>
        </section>
      );
    })}
  </div>
  <p class="muted">E-mail: <a href="mailto:info-med@medunion.group">info-med@medunion.group</a></p>
</div>
