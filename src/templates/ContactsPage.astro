---
// /contacts/: all clinics, each with hours, phones, ratings and a link to its own page.
import type { CollectionEntry } from 'astro:content';
import PageHead from '../components/PageHead.astro';
import Ratings from '../components/Ratings.astro';
import Social from '../components/Social.astro';
import { clinics, clinicPage, phones, type ClinicKey } from '../data/site';
import { isKansk, city, MAIN_ORIGIN } from '../data/city';

interface Props { entry: CollectionEntry<'pages'> }
const d = Astro.props.entry.data;
const keys = (isKansk ? city.clinics : Object.keys(clinics)) as ClinicKey[];
const route = (k: ClinicKey) => `https://yandex.ru/maps/?rtext=~${clinics[k].coords[0]},${clinics[k].coords[1]}&rtt=auto`;
---

<PageHead url={d.url} h1={d.h1} compact />

<div class="wrap page-body">
  <div class="clinic-grid block">
    {keys.map((k) => {
      const c = clinics[k];
      return (
        <section class="clinic-card">
          <p class="clinic-city">{c.city}{c.district && `, ${c.district}`}</p>
          <h2><a href={clinicPage[k]}>{c.address}</a></h2>
          <ul class="hours">{c.hours.map((h) => <li>{h}</li>)}</ul>
          <p class="clinic-phone">{c.phones.map((p) => <a href={`tel:${p.tel}`}>{p.display}</a>)}</p>
          <Ratings ratings={c.ratings} compact checked={false} />
          <div class="cta-row">
            <a class="btn btn-quiet" href={clinicPage[k]}>О клинике</a>
            <a class="btn btn-quiet" href={route(k)} target="_blank" rel="noopener">Как добраться</a>
          </div>
        </section>
      );
    })}
  </div>
  {isKansk && (
    <p class="block muted">Клиники в Красноярске (Курчатова, 17 и Инструментальная, 12/35): <a href={`${MAIN_ORIGIN}/contacts/`}>адреса и телефоны</a>.</p>
  )}
  <section class="block">
    <h2>Общие контакты</h2>
    <dl class="contact-facts">
      <div>
        <dt>Запись и вопросы</dt>
        <dd><a class="contact-strong" href={`tel:${city.phone.tel}`}>{city.phone.display}</a><span class="muted">{isKansk ? 'клиника в Канске' : 'единый номер, все клиники'}</span></dd>
      </div>
      <div>
        <dt>Электронная почта</dt>
        <dd><a class="contact-strong" href="mailto:info-med@medunion.group">info-med@medunion.group</a></dd>
      </div>
      <div>
        <dt>Оплата</dt>
        <dd><span class="contact-strong">Наличными и картой</span><span class="muted">во всех клиниках</span></dd>
      </div>
      <div>
        <dt>Мы в соцсетях</dt>
        <dd><Social size={28} class="contact-social" /></dd>
      </div>
    </dl>
  </section>
</div>
