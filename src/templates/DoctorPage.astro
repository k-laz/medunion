---
import { render, getCollection, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PriceList from '../components/PriceList.astro';
import DoctorSchedule from '../components/DoctorSchedule.astro';
import ReviewList from '../components/ReviewList.astro';
import ReviewForm from '../components/ReviewForm.astro';
import { servicesOfDoctor, initials, years, tileLabel } from '../lib/content';
import { clinics, integrations, phones, bookingPage } from '../data/site';

interface Props { entry: CollectionEntry<'doctors'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hasText = (entry.body ?? '').trim().length > 0;
const services = await servicesOfDoctor(entry.id);
const bookingUrl = bookingPage; // our /appointment/ page
const reviews = await getCollection('reviews', (r) => r.data.doctor?.id === entry.id);
const pages: Record<string, string> = {
  kurchatova: '/contacts/klinika-na-kurchatova/',
  instrumentalnaya: '/contacts/klinika-na-instrumentalnoy/',
  kansk: '/contacts/klinika-v-kanske/',
};
---

<section class="page-head page-head-crumbs">
  <div class="wrap">
    <Breadcrumbs url={d.url} />
  </div>
</section>

<div class="wrap doctor-page">
  <aside class="doctor-side">
    <div class="doctor-portrait">
      {d.photo ? <img src={d.photo} alt={d.name} /> : <span aria-hidden="true">{initials(d.name)}</span>}
    </div>
    <div class="doctor-side-actions">
      <a class="btn btn-primary btn-wide" href="#schedule">Записаться на приём</a>
      <a class="btn btn-quiet btn-wide" href="#review-form">Оставить отзыв</a>
      <a class="doctor-side-phone" href={`tel:${phones.main.tel}`}>{phones.main.display}</a>
    </div>
  </aside>

  <div class="doctor-main">
    <h1>{d.name}</h1>
    <p class="lead">{d.specialty}</p>

    <dl class="doctor-facts">
      {d.experienceYears && (<div><dt>Стаж работы</dt><dd>{years(d.experienceYears)}</dd></div>)}
      {d.qualification && (<div><dt>Категория</dt><dd>{d.qualification}</dd></div>)}
      {d.clinics.length > 0 && (
        <div>
          <dt>Ведёт приём</dt>
          <dd>{d.clinics.map((k, i) => <>{i > 0 && ', '}<a href={pages[k]}>{clinics[k].city}, {clinics[k].address}</a></>)}</dd>
        </div>
      )}
      {d.specialization && (<div><dt>Специализация</dt><dd>{d.specialization}</dd></div>)}
    </dl>

    <DoctorSchedule doctorUrl={d.url} clinicKeys={d.clinics} />

    {hasText && <div class="prose block"><Content /></div>}

    {d.education.length > 0 && (
      <section class="block">
        <h2>Образование</h2>
        <ul class="prose-list">{d.education.map((e) => <li>{e}</li>)}</ul>
      </section>
    )}

    {d.prices.length > 0 && (
      <section class="block">
        <h2>Стоимость приёма</h2>
        <PriceList items={d.prices} />
      </section>
    )}

    {services.length > 0 && (
      <section class="block">
        <h2>Услуги</h2>
        <ul class="tile-grid tile-grid-2">
          {services.map((s) => <li><a class="tile" href={s.data.url}><span>{tileLabel(s.data.h1)}</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></a></li>)}
        </ul>
      </section>
    )}

    <section class="block" id="reviews">
      <h2>Отзывы{reviews.length > 0 && <span class="count"> {reviews.length}</span>}</h2>
      {reviews.length > 0 ? <ReviewList reviews={reviews} /> : <p class="muted">Об этом враче пока нет отзывов на сайте. Будем рады, если вы поделитесь впечатлениями.</p>}
      <ReviewForm doctorUrl={d.url} doctorName={d.name} />
    </section>
  </div>
</div>

<div class="page-body"></div>
