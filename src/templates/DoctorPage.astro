---
import { city } from '../data/city';
// Doctor page. Left: photo, booking and review buttons, links to the page's
// sections. Right: name and key facts, schedule, about, education, prices,
// reviews and other doctors of the same department.
import { render, getCollection, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PriceList from '../components/PriceList.astro';
import DoctorSchedule from '../components/DoctorSchedule.astro';
import ReviewList from '../components/ReviewList.astro';
import DoctorCard from '../components/DoctorCard.astro';
import { servicesOfDoctor, initials, years, rub, shortName, photoFor } from '../lib/content';
import { clinics, phones, reviewsPage, reviewFormPage, bookingPage, showSchedule } from '../data/site';
import { currentPrices } from '../lib/prices';

interface Props { entry: CollectionEntry<'doctors'> }
const { entry } = Astro.props;
const d = entry.data;
const photo = await photoFor(d.url, d.photo);
const { Content } = await render(entry);
const hasText = (entry.body ?? '').trim().length > 0;
const services = await servicesOfDoctor(entry.id);
const reviews = await getCollection('reviews', (r) => r.data.doctor === entry.id);
const pages: Record<string, string> = {
  kurchatova: '/contacts/klinika-na-kurchatova/',
  instrumentalnaya: '/contacts/klinika-na-instrumentalnoy/',
  kansk: '/contacts/klinika-v-kanske/',
};

// Prices: the doctor's own list, otherwise the consultations ("приём",
// "консультация") of the services this doctor is listed on.
const visit = /при[её]м|консультац/i;
// Rows naming another doctor ("... Мыльников И.И.") were copied onto the
// wrong page on the old site, so they are left out.
const surname = d.name.split(/\s+/)[0];
const ownRows = currentPrices(d.prices).filter((p) => {
  const m = p.name.match(/([А-ЯЁ][а-яё]+(?:-[А-ЯЁ][а-яё]+)?)\s+[А-ЯЁ]\.\s?[А-ЯЁ]\.?\s*\)?$/);
  return !m || m[1] === surname;
});
const prices = ownRows.length
  ? ownRows
  : [...new Map(currentPrices(services.flatMap((s) => s.data.prices)).filter((p) => visit.test(p.name)).map((p) => [p.name, p])).values()];
const from = prices.length ? Math.min(...prices.map((p) => p.price)) : 0;

// Education, in two lists: degrees (university, residency, retraining) as a
// timeline from oldest, and short courses (повышение квалификации, циклы,
// конференции) newest first, the first few shown and the rest folded.
// "2005 г. - Текст", "в 1994 году окончил…", "2023г. - «Курс»" -> year + text
const DEGREE = /ординатур|интернатур|аспирантур|базов|диплом|окончил|переподготов|лечебн\S* (дело|факультет)|медицинск\S* (университет|институт|академи)[^,.]*\s*\(([а-яё\s,-]+)\)\s*\.?$/i;
const COURSE = /повышени\S* квалификац|сертификат|семинар|конференц|\bцикл|\bкурс|^«|^"/i;
const parsed = d.education.map((e, i) => {
  const m = e.match(/^\s*(?:в\s+)?((?:19|20)\d\d)\s*(?:г(?:г|од[ау]?)?\.?)?\s*[-–—:]?\s*(.+)$/i);
  const text = (m ? m[2] : e).trim().replace(/\.$/, '');
  return { year: m ? m[1] : '', text, i };
});
const isCourse = (e: { year: string; text: string }) => !!e.year && !DEGREE.test(e.text) && COURSE.test(e.text);
const byYear = (a: { year: string; i: number }, b: { year: string; i: number }) =>
  (a.year ? 0 : 1) - (b.year ? 0 : 1) || (a.year || '').localeCompare(b.year || '') || a.i - b.i;
const education = parsed.filter((e) => !isCourse(e)).sort(byYear);
const courses = parsed.filter(isCourse).sort((a, b) => b.year.localeCompare(a.year) || a.i - b.i);
const COURSES_SHOWN = 5;

// Other doctors of the same department: the section this doctor's page sits in
const section = d.url.split('/').slice(0, 3).join('/') + '/';
const sectionList = (await getCollection('listings')).find((l) => l.data.url === section);
const colleagues = (await getCollection('doctors'))
  .filter((x) => x.id !== entry.id && (x.data.url.startsWith(section) || sectionList?.data.members?.includes(x.data.url)))
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'ru'))
  .slice(0, 3);

const anchors = [
  hasText && { id: 'about', label: 'О враче' },
  (education.length || courses.length) && { id: 'education', label: 'Образование' },
  prices.length && { id: 'prices', label: 'Цены' },
  reviews.length && { id: 'reviews', label: 'Отзывы' },
].filter(Boolean) as { id: string; label: string }[];
---

<section class="page-head page-head-crumbs">
  <div class="wrap">
    <Breadcrumbs url={d.url} />
  </div>
</section>

<div class="wrap doctor-page">
  <aside class="doctor-side">
    <div class:list={['doctor-portrait', { 'no-photo': !photo }]}>
      {photo ? <img src={photo} alt={d.name} width="640" height="800" /> : <span aria-hidden="true">{initials(d.name)}</span>}
    </div>
    <div class="doctor-side-actions">
      <a class="btn btn-primary btn-wide" href={showSchedule ? '#schedule' : bookingPage}>Записаться на приём</a>
      <a class="btn btn-quiet btn-wide" href={`${reviewFormPage}?doctor=${encodeURIComponent(d.url)}`}>Оставить отзыв</a>
      <a class="doctor-side-phone" href={`tel:${city.phone.tel}`}>{city.phone.display}</a>
    </div>
    {anchors.length > 1 && (
      <nav class="chips doctor-anchors" aria-label="Разделы страницы">
        {anchors.map((a) => <a class="chip" href={`#${a.id}`}>{a.label}</a>)}
      </nav>
    )}
  </aside>

  <div class="doctor-main">
    <div class="doctor-card-head">
      <h1>{d.name}</h1>
      <p class="lead">{d.specialty}</p>
      <dl class="doctor-stats">
        {d.experienceYears && <div><dt>Врачебный стаж</dt><dd>{years(d.experienceYears)}</dd></div>}
        {from > 0 && <div><dt>Приём врача</dt><dd>от {rub(from)}</dd></div>}
        {d.qualification && <div><dt>Категория</dt><dd>{d.qualification}</dd></div>}
      </dl>
      {d.clinics.length > 0 && (
        <p class="doctor-where">
          <span class="muted">Ведёт приём:</span>
          {d.clinics.map((k, i) => <>{i > 0 && ', '}<a href={pages[k]}>{clinics[k].city}, {clinics[k].address}</a></>)}
        </p>
      )}
      {d.specialization && <p class="doctor-where"><span class="muted">Специализация:</span> {d.specialization}</p>}
      {services.length > 0 && (
        <div class="doctor-depts">
          <span class="muted">Направления</span>
          <div class="chips">{services.map((s) => <a class="chip" href={s.data.url}>{shortName(s.data.url, s.data.h1)}</a>)}</div>
        </div>
      )}
    </div>

    {showSchedule && <DoctorSchedule doctorUrl={d.url} clinicKeys={d.clinics} />}

    {hasText && (
      <section class="block" id="about">
        <h2>О враче</h2>
        <div class="prose"><Content /></div>
      </section>
    )}

    {(education.length > 0 || courses.length > 0) && (
      <section class="block" id="education">
        <h2>Образование</h2>
        {education.length > 0 && (
          <ol class="timeline">
            {education.map((e) => (
              <li>
                {e.year && <span class="timeline-year">{e.year}</span>}
                <span>{e.text}</span>
              </li>
            ))}
          </ol>
        )}
        {courses.length > 0 && (
          <div class="courses" data-courses>
            <h3>Повышение квалификации</h3>
            <ul class="course-list">
              {courses.map((c, i) => (
                <li class:list={{ 'course-more': i >= COURSES_SHOWN }}>
                  <span class="course-year">{c.year}</span>
                  <span>{c.text}</span>
                </li>
              ))}
            </ul>
            {courses.length > COURSES_SHOWN + 1 && (
              <button class="more-btn courses-toggle" type="button">Показать все ({courses.length})</button>
            )}
          </div>
        )}
      </section>
    )}

    {prices.length > 0 && (
      <section class="block" id="prices">
        <div class="block-head">
          <h2>Стоимость приёма</h2>
          <a class="link-more" href="/ceny/">Все цены</a>
        </div>
        <PriceList items={prices} id="doctor-prices" />
      </section>
    )}

    {reviews.length > 0 && (
      <section class="block" id="reviews">
        <div class="block-head">
          <h2>Отзывы <span class="count">{reviews.length}</span></h2>
          <a class="link-more" href={reviewsPage}>Все отзывы</a>
        </div>
        <ReviewList reviews={reviews} />
      </section>
    )}

    {colleagues.length > 0 && (
      <section class="block">
        <div class="block-head">
          <h2>Другие врачи отделения</h2>
          <a class="link-more" href={section}>Все</a>
        </div>
        <div class="doctor-grid">
          {colleagues.map((c) => (
            <DoctorCard name={c.data.name} specialty={c.data.specialty} url={c.data.url} photo={c.data.photo} experienceYears={c.data.experienceYears} clinicKeys={c.data.clinics} />
          ))}
        </div>
      </section>
    )}
  </div>
</div>

<div class="page-body"></div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-courses]')) {
    const btn = box.querySelector<HTMLButtonElement>('.courses-toggle');
    if (!btn) { box.classList.add('is-open'); continue; }
    btn.addEventListener('click', () => { box.classList.add('is-open'); btn.remove(); });
  }
</script>
