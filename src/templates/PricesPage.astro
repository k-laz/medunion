---
import type { CollectionEntry } from 'astro:content';
import PageHead from '../components/PageHead.astro';
import PriceList from '../components/PriceList.astro';

interface Props { entry: CollectionEntry<'prices'> }
const d = Astro.props.entry.data;
---

<PageHead url={d.url} h1={d.h1} compact />

<div class="wrap page-body">
  <section class="block narrow">
    {d.items.length > 0 ? <PriceList items={d.items} /> : <p>Цены уточняйте по телефону.</p>}
  </section>
</div>
