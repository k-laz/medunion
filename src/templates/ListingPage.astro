---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageHead from '../components/PageHead.astro';
import DoctorCard from '../components/DoctorCard.astro';
import PricesOverview from '../components/PricesOverview.astro';
import { saleGroups, validity } from '../data/sales';
import { saleInfo as loadSaleInfo } from '../lib/sales';
const saleInfo = await loadSaleInfo();

interface Props { entry: CollectionEntry<'listings'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const intro = (entry.body ?? '').trim();
const under = <T extends { data: { url: string } }>(list: T[]) => list.filter((e) => e.data.url !== d.url && e.data.url.startsWith(d.url));
const clean = (s: string) => s.replace(/\s*в Красноярске$/, '').replace(/"([^"]+)"?/g, '«$1»');

let doctors: CollectionEntry<'doctors'>[] = [];
let groups: { url: string; label: string }[] = [];
let links: { url: string; label: string }[] = [];
type Offer = { url: string; title: string; summary?: string; badge?: string; until?: string; group: string };
let offers: Offer[] = [];
// Sort offers: biggest discount first, then by title
const pct = (o: Offer) => Number(o.badge?.match(/(\d+)%/)?.[1] ?? 0);
if (d.of === 'doctors') {
  const all = await getCollection('doctors');
  // Doctors the old page listed, plus any whose address is inside this section
  const everyone = /^Все врачи/.test(d.h1);
  const picked = all.filter((doc) => everyone || d.members?.includes(doc.data.url) || doc.data.groups.includes(d.url) || (doc.data.url !== d.url && doc.data.url.startsWith(d.url)));
  doctors = picked.sort((a, b) => a.data.name.localeCompare(b.data.name, 'ru'));
  // Specialty filters: the doctor sections under /vrachi/
  // Short filter labels: "Врачи-гинекологи" becomes "Гинекологи". Page titles keep the full name.
  const short = (h1: string) => {
    const t = clean(h1).replace(/\s*«Медюнион»$/, '').replace(/^Врачи[\s:-]+/, '').replace(/^отделение диагностики$/i, 'Диагностика');
    return t[0].toUpperCase() + t.slice(1);
  };
  groups = [
    { url: '/vrachi/', label: 'Все врачи' },
    ...(await getCollection('listings'))
      .filter((l) => l.data.of === 'doctors' && l.data.url !== '/vrachi/' && l.data.url.split('/').length === 4 && !/^Все врачи/.test(l.data.h1))
      .map((l) => ({ url: l.data.url, label: short(l.data.h1) }))
      .sort((a, b) => a.label.localeCompare(b.label, 'ru')),
  ];
} else if (d.of === 'prices') {
  // /ceny/ shows every list on one page (PricesOverview), no tiles
} else {
  const kind = d.of === 'news' ? 'news' : d.of === 'sales' ? 'sale' : 'article';
  const items = (await getCollection('articles')).filter((a) => a.data.kind === kind);
  const listed = d.of === 'articles' ? under(items) : items;
  // News: newest first. Everything else alphabetical.
  if (d.of === 'news') listed.sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
  if (d.of === 'sales') {
    offers = listed.map((a) => {
      const info = saleInfo[a.data.url];
      return {
        url: a.data.url,
        title: info?.title ?? a.data.h1,
        summary: info?.summary,
        badge: info?.badge ?? (a.data.discount ? `−${a.data.discount}` : undefined),
        until: validity(a.data.period),
        group: info?.group ?? 'special',
      };
    });
  } else links = listed.map((a) => ({ url: a.data.url, label: a.data.h1 }));
  if (d.of === 'articles') {
    const cats = under(await getCollection('listings')).filter((l) => l.data.of === 'articles');
    groups = cats.map((c) => ({ url: c.data.url, label: c.data.h1 })).sort((a, b) => a.label.localeCompare(b.label, 'ru'));
  }
}
if (d.of !== 'news') links.sort((a, b) => a.label.localeCompare(b.label, 'ru'));
---

<PageHead url={d.url} h1={d.of === 'prices' ? 'Цены на услуги' : clean(d.h1)} lead={d.of === 'sales' ? 'Скидки и спецпредложения клиник Медюнион. Скидки и акции между собой не суммируются.' : d.of === 'prices' ? 'Цены клиник Медюнион в Красноярске и Канске.' : undefined} compact>
  {groups.length > 0 && (
    <nav class="chips" aria-label="Разделы">
      {groups.map((g) => <a class="chip" href={g.url} aria-current={g.url === d.url ? 'page' : undefined}>{g.label}</a>)}
    </nav>
  )}
</PageHead>

<div class="wrap page-body">
  {intro && intro.length > 120 && d.of !== 'sales' && d.of !== 'prices' && <div class="prose block"><Content /></div>}

  {d.of === 'prices' && <PricesOverview />}

  {saleGroups.map((g) => {
    const list = offers.filter((o) => o.group === g.key).sort((a, b) => pct(b) - pct(a) || a.title.localeCompare(b.title, 'ru'));
    return list.length > 0 && (
      <section class="block">
        <div class="block-head"><h2>{g.title}</h2></div>
        <p class="muted offer-group-text">{g.text}</p>
        <ul class="offer-grid">
          {list.map((o) => (
            <li>
              <a class="offer-card" href={o.url}>
                {o.badge && <span class="offer-card-badge">{o.badge}</span>}
                <strong>{o.title}</strong>
                {o.summary && <span class="offer-card-text">{o.summary}</span>}
                <span class="offer-card-foot">
                  {o.until && <span class="muted">{o.until}</span>}
                  <span class="offer-card-more">Подробнее<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}

  {doctors.length > 0 && <div class="doctor-grid block">{doctors.map((doc) => (
    <DoctorCard name={doc.data.name} specialty={doc.data.specialty} url={doc.data.url} photo={doc.data.photo} experienceYears={doc.data.experienceYears} clinicKeys={doc.data.clinics} />
  ))}</div>}

  {d.of === 'doctors' && doctors.length === 0 && (
    <p class="block">Сейчас в этом разделе нет врачей на сайте. Уточните расписание по телефону <a href="tel:+73912200303">+7 (391) 220-03-03</a> или посмотрите <a href="/vrachi/">всех врачей</a>.</p>
  )}

  {links.length > 0 && (
    <ul class:list={['tile-grid', 'block', { 'tile-grid-2': d.of !== 'prices' }]}>
      {links.map((l) => <li><a class="tile" href={l.url}><span>{l.label}</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></a></li>)}
    </ul>
  )}

</div>
