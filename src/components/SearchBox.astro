---
// Search field with instant suggestions from /search.json. Only searches
// this site (no web search). Without JavaScript, Enter opens the catalog.
interface Props { id: string; large?: boolean; placeholder?: string }
const { id, large = false, placeholder = 'Врач, услуга или исследование' } = Astro.props;
---

<form class:list={['search', { 'search-lg': large }]} action="/uslugi/" method="get" role="search" data-search>
  <label class="sr-only" for={id}>Поиск по сайту</label>
  <input id={id} name="q" type="search" autocomplete="off" placeholder={placeholder} />
  <button class="btn btn-primary" type="submit">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4" /><path d="m20 20-4-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
    <span>Найти</span>
  </button>
  <ul class="search-results" role="listbox" hidden></ul>
</form>

<script>
  import { search } from '../lib/search.js';
  type Item = { t: string; u: string; k: string; d?: string };
  let index: Promise<Item[]> | null = null;
  const load = () => (index ??= fetch('/search.json').then((r) => r.json()));

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-search]')) {
    if (form.dataset.ready) continue;
    form.dataset.ready = '1';
    const input = form.querySelector<HTMLInputElement>('input[type=search]')!;
    const list = form.querySelector<HTMLUListElement>('.search-results')!;

    const show = async () => {
      const q = input.value.trim();
      if (q.length < 2) { list.hidden = true; return; }
      const hits = search(await load(), q, 8);
      if (input.value.trim() !== q) return; // typed on meanwhile
      list.innerHTML = '';
      for (const i of hits) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = i.u;
        a.innerHTML = '<span></span><small></small>';
        a.children[0].textContent = i.t;
        a.children[1].textContent = i.k;
        li.append(a);
        list.append(li);
      }
      if (!hits.length) {
        list.innerHTML = '<li class="search-empty">Ничего не нашлось. Посмотрите <a href="/uslugi/">все услуги</a> или позвоните <a href="tel:+73912200303">+7 (391) 220-03-03</a>, подскажем.</li>';
      }
      list.hidden = false;
    };

    input.addEventListener('focus', () => { load(); }, { once: true });
    input.addEventListener('input', show);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      await show();
      const first = list.querySelector<HTMLAnchorElement>('li:not(.search-empty) a');
      if (first) location.href = first.href;
    });
    document.addEventListener('click', (e) => { if (!form.contains(e.target as Node)) list.hidden = true; });
    input.addEventListener('keydown', (e) => { if (e.key === 'Escape') list.hidden = true; });
  }
</script>
