---
// Price list with dotted leaders. Long lists get a filter box and show the
// first `fold` rows, with "Ещё N услуг" to open the rest.
import { rub } from '../lib/content';
interface Props { items: { name: string; price: number }[]; checkedOn?: Date; id?: string; fold?: number; note?: boolean }
const { items, checkedOn, id = 'prices-filter', fold = 6, note = true } = Astro.props;
const folding = items.length > fold + 2;
const hiddenCount = items.length - fold;
const more = (n: number) => `Ещё ${n} ${n % 10 === 1 && n % 100 !== 11 ? 'услуга' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'услуги' : 'услуг'}`;
const checkedText = checkedOn?.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<div class:list={['prices', { 'is-folded': folding }]} data-prices>
  {items.length > 8 && (
    <div class="prices-filter">
      <label class="sr-only" for={id}>Найти в прайсе</label>
      <input id={id} type="search" placeholder="Найти исследование или приём" autocomplete="off" />
    </div>
  )}
  <dl class="price-list">
    {items.map((p, i) => (
      <div class:list={['price-row', { 'price-more': folding && i >= fold }]}>
        <dt class="price-name">{p.name}</dt>
        <span class="price-dots" aria-hidden="true"></span>
        <dd class="price-value">{rub(p.price)}</dd>
      </div>
    ))}
  </dl>
  {folding && <button class="more-btn prices-toggle" type="button" data-more={more(hiddenCount)}>{more(hiddenCount)}</button>}
  <p class="prices-empty" hidden>Ничего не нашлось. Уточните по телефону.</p>
  {note && <p class="prices-note">{checkedText ? `Цены на ${checkedText.replace(/\.$/, '')}. ` : ''}Не является публичной офертой. Точную стоимость уточняйте при записи.</p>}
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-prices]')) {
    const toggle = box.querySelector<HTMLButtonElement>('.prices-toggle');
    toggle?.addEventListener('click', () => {
      const open = box.classList.toggle('is-folded') === false;
      toggle.textContent = open ? 'Свернуть' : toggle.dataset.more!;
    });
    const input = box.querySelector<HTMLInputElement>('input');
    if (!input) continue;
    const rows = [...box.querySelectorAll<HTMLElement>('.price-row')];
    const empty = box.querySelector<HTMLElement>('.prices-empty')!;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase().replace(/ё/g, 'е');
      let shown = 0;
      for (const r of rows) {
        const hit = !q || r.textContent!.toLowerCase().replace(/ё/g, 'е').includes(q);
        r.hidden = !hit;
        if (hit) shown++;
      }
      empty.hidden = shown > 0;
      box.classList.toggle('is-searching', !!q); // a search shows every match, folded or not
    });
  }
</script>
