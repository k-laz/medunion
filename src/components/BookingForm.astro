---
// Online booking, live from the МИС «Ариадна» through our server
// (deploy/api/server.mjs, /api/booking/...).
//   1. pick a doctor: cards with photo, filter by specialty, search by name;
//      or «Любой врач» of a specialty: the nearest free time of all of them
//   2. a week calendar of their free time (days without time are greyed out)
//   3. the patient's details, then the booking
// Opened from a doctor's page (?doctor=/vrachi/.../), that doctor is chosen already.
// If the server can't be reached the form hides itself and the phone stays.
import { getCollection } from 'astro:content';
import { apiBase, consentPage } from '../data/site';
import { city } from '../data/city';
import { photoFor } from '../lib/content';

// What the site knows about each doctor, to dress up the МИС's bare names
const site = await Promise.all(
  (await getCollection('doctors')).map(async (d) => {
    const prices = (d.data.prices ?? []).map((p) => p.price).filter((p): p is number => typeof p === 'number' && p > 0);
    return {
      url: d.data.url,
      name: d.data.name,
      specialty: d.data.specialty,
      qualification: d.data.qualification ?? '',
      price: prices.length ? Math.min(...prices) : 0,
      photo: (await photoFor(d.data.url, d.data.photo)) ?? '',
    };
  }),
);
---

<form class="review-form booking info-card" data-booking-form data-api={`${apiBase}/booking`} data-site={JSON.stringify(site)} data-phone={city.phone.display} data-tel={city.phone.tel} novalidate hidden>
  <!-- 1. Doctor -->
  <section class="booking-step" data-step="pick">
    <div class="booking-filter">
      <label class="booking-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" name="q" placeholder="Врач или специальность" autocomplete="off" aria-label="Врач или специальность" />
      </label>
      <select name="spec" aria-label="Специальность"><option value="">Все специальности</option></select>
    </div>
    <div class="booking-docs" role="list"></div>
    <p class="muted booking-none" hidden>Никого не нашли. Попробуйте другую специальность или позвоните нам.</p>
  </section>

  <!-- 2. Time -->
  <section class="booking-step" data-step="when" hidden>
    <div class="booking-who"></div>
    <div class="booking-chips" data-specs hidden></div>
    <div class="booking-chips" data-clinics hidden></div>
    <div class="booking-cal">
      <h3 class="booking-cal-title">Выберите день и время</h3>
      <div class="booking-cal-head">
        <button type="button" class="booking-arrow" data-week="-1" aria-label="Предыдущая неделя">‹</button>
        <strong class="booking-range"></strong>
        <button type="button" class="booking-arrow" data-week="1" aria-label="Следующая неделя">›</button>
      </div>
      <div class="booking-week" role="tablist" aria-label="День"></div>
      <p class="booking-dayname"></p>
      <div class="booking-times" aria-label="Время"></div>
      <p class="muted booking-empty" hidden></p>
    </div>
  </section>

  <!-- 3. Patient -->
  <section class="booking-step booking-patient" data-step="patient" hidden>
    <h3 class="booking-cal-title">Ваши данные</h3>
    <p class="booking-chosen"></p>
    <div class="form-row">
      <label><span>Фамилия</span><input name="surname" autocomplete="family-name" maxlength="60" required /></label>
      <label><span>Имя</span><input name="firstName" autocomplete="given-name" maxlength="60" required /></label>
    </div>
    <div class="form-row">
      <label><span>Отчество <small class="muted">если есть</small></span><input name="secondName" autocomplete="additional-name" maxlength="60" /></label>
      <label><span>Дата рождения</span><input name="birthDate" type="date" autocomplete="bday" required /></label>
    </div>
    <div class="form-row">
      <label><span>Телефон</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="20" placeholder="+7" required /></label>
      <label><span>Электронная почта</span><input name="email" type="email" autocomplete="email" maxlength="120" required /></label>
    </div>
    <div class="booking-captcha">
      <div class="booking-captcha-img" aria-hidden="true"></div>
      <label><span>Код с картинки <button type="button" class="link-btn" data-new-captcha>другой код</button></span><input name="captchaValue" autocomplete="off" maxlength="20" required /></label>
    </div>
    <label class="check">
      <input type="checkbox" name="consent" required />
      <span>Согласен на <a href={consentPage} target="_blank" rel="noopener">обработку персональных данных</a></span>
    </label>
    <button class="btn btn-primary" type="submit">Записаться</button>
  </section>

  <p class="form-status" role="status" hidden></p>
</form>

<script>
  type Spec = { id: string; name: string };
  type Doc = { id: string; name: string; specs: Spec[] };
  type Slot = { id: string; start: string; end: string; clinic: string; doctor?: string; doctorName?: string; clinicName?: string };
  type SiteDoc = { url: string; name: string; specialty: string; qualification: string; price: number; photo: string };

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-booking-form]')) {
    if (form.dataset.ready) continue;
    form.dataset.ready = '1';
    const api = form.dataset.api!;
    const phone = `<a href="tel:${form.dataset.tel}">${form.dataset.phone}</a>`;
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => form.querySelector<T>(s)!;
    const step = (n: string) => $(`[data-step=${n}]`);
    const status = $('.form-status');
    const q = $<HTMLInputElement>('[name=q]');
    const specSel = $<HTMLSelectElement>('[name=spec]');
    const docsBox = $('.booking-docs');
    const who = $('.booking-who');
    const specChips = $('[data-specs]');
    const clinicChips = $('[data-clinics]');
    const week = $('.booking-week');
    const range = $('.booking-range');
    const dayName = $('.booking-dayname');
    const times = $('.booking-times');
    const empty = $('.booking-empty');
    const chosen = $('.booking-chosen');
    const captchaImg = $('.booking-captcha-img');
    const weekArrows = form.querySelectorAll<HTMLButtonElement>('[data-week]');

    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };
    const say = (html: string, ok = false) => {
      status.hidden = !html;
      status.className = `form-status ${ok ? 'is-ok' : 'is-error'}`;
      status.innerHTML = html;
    };
    const fail = (e: unknown) => say(`${esc((e as Error).message)} Запишитесь по телефону ${phone}.`);
    async function get<T>(path: string, params: Record<string, string> = {}): Promise<T> {
      const res = await fetch(`${api}/${path}?${new URLSearchParams(params)}`);
      const body = await res.json().catch(() => ({}));
      if (!res.ok || !body.ok) throw new Error(body.error || 'Ошибка');
      return body.data as T;
    }

    // ---- names: the МИС writes «Иванов Иван Иванович», the site the same, maybe with ё
    const norm = (s: string) => s.toLowerCase().replace(/ё/g, 'е').replace(/[^а-яa-z\s]/g, ' ').replace(/\s+/g, ' ').trim();
    const key = (s: string) => norm(s).split(' ').slice(0, 2).join(' ');
    const siteDocs = JSON.parse(form.dataset.site || '[]') as SiteDoc[];
    const siteByName = new Map(siteDocs.map((d) => [key(d.name), d]));
    const isRoom = (n: string) => /^(мрт|кт|мскт|рентген|узи|флюоро|маммо|кабинет)/i.test(n) || /\d/.test(n);
    const initials = (n: string) => n.split(' ').slice(0, 2).map((w) => w[0] || '').join('').toUpperCase();
    const rub = (n: number) => `${n.toLocaleString('ru-RU')} ₽`;

    // ---- dates: "30.11.2026 13:00" (or ISO) -> parts
    const split = (s: string) => {
      const m = s.match(/(\d{2}\.\d{2}\.\d{4}|\d{4}-\d{2}-\d{2})\D+(\d{1,2}:\d{2})/);
      if (!m) return { day: s, time: '' };
      const day = m[1].includes('-') ? m[1].split('-').reverse().join('.') : m[1];
      return { day, time: m[2].padStart(5, '0') };
    };
    const toDate = (day: string) => { const [d, m, y] = day.split('.').map(Number); return new Date(y, m - 1, d); };
    const dayKey = (d: Date) => `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;
    const monday = (d: Date) => { const x = new Date(d.getFullYear(), d.getMonth(), d.getDate()); x.setDate(x.getDate() - ((x.getDay() + 6) % 7)); return x; };
    const addDays = (d: Date, n: number) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
    const fmt = (d: Date, o: Intl.DateTimeFormatOptions) => d.toLocaleDateString('ru-RU', o);
    const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

    // ---- state
    let all: Doc[] = [];
    let current: { doc: Doc | null; spec: Spec; any: boolean } | null = null;
    let slots: Slot[] = [];
    let clinicNames: Record<string, string> = {};
    let clinic = '';
    let weekStart = monday(new Date());
    let selectedDay = '';
    let slot: Slot | null = null;
    let captchaId = '';

    const show = (name: 'pick' | 'when' | 'patient') => {
      step('pick').hidden = name !== 'pick';
      step('when').hidden = name === 'pick';
      step('patient').hidden = name !== 'patient';
    };

    // ================= 1. doctors =================
    function avatar(name: string, info?: SiteDoc) {
      const a = el('span', 'booking-avatar');
      if (info?.photo) {
        const img = el('img');
        img.src = info.photo;
        img.alt = '';
        img.loading = 'lazy';
        a.append(img);
      } else a.append(el('span', '', isRoom(name) ? name.split(' ')[0] : initials(name)));
      if (isRoom(name)) a.classList.add('is-room');
      return a;
    }
    function card(title: string, lines: string[], pic: HTMLElement, onClick: () => void) {
      const b = el('button', 'booking-doc');
      b.type = 'button';
      b.setAttribute('role', 'listitem');
      const text = el('span', 'booking-doc-text');
      text.append(el('strong', '', title));
      for (const [i, l] of lines.filter(Boolean).entries()) text.append(el('span', i ? 'booking-doc-meta' : 'booking-doc-spec', l));
      b.append(pic, text, el('span', 'booking-doc-go'));
      b.addEventListener('click', onClick);
      return b;
    }
    function renderDocs() {
      const words = norm(q.value).split(' ').filter(Boolean);
      const spec = specSel.value;
      const list = all.filter((d) => {
        if (spec && !d.specs.some((s) => s.id === spec)) return false;
        if (!words.length) return true;
        const info = siteByName.get(key(d.name));
        const hay = norm([d.name, info?.specialty ?? '', ...d.specs.map((s) => s.name)].join(' '));
        return words.every((w) => hay.includes(w));
      });
      docsBox.replaceChildren();
      if (spec && !words.length && list.length > 1) {
        const icon = el('span', 'booking-avatar is-any');
        icon.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>';
        const sp = all.flatMap((d) => d.specs).find((s) => s.id === spec)!;
        docsBox.append(card('Любой врач', ['Ближайшее свободное время'], icon, () => open(null, sp)));
      }
      for (const d of list) {
        const info = siteByName.get(key(d.name));
        const specText = info?.specialty || d.specs.map((s) => s.name).join(', ');
        const meta = [info?.qualification, info?.price ? `Приём от ${rub(info.price)}` : ''].filter(Boolean).join(' · ');
        docsBox.append(card(d.name, [specText, meta], avatar(d.name, info), () => open(d)));
      }
      $('.booking-none').hidden = list.length > 0;
    }
    q.addEventListener('input', renderDocs);
    specSel.addEventListener('change', renderDocs);

    // ================= 2. calendar =================
    async function open(doc: Doc | null, spec?: Spec) {
      say('');
      const specs = doc ? doc.specs : [spec!];
      const chosenSpec = spec ?? specs.find((s) => s.id === specSel.value) ?? specs[0];
      current = { doc, spec: chosenSpec, any: !doc };
      // who
      who.replaceChildren();
      const info = doc ? siteByName.get(key(doc.name)) : undefined;
      const pic = doc ? avatar(doc.name, info) : el('span', 'booking-avatar is-any', '');
      if (!doc) pic.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>';
      const text = el('span', 'booking-doc-text');
      text.append(el('strong', '', doc ? doc.name : `Любой врач: ${chosenSpec.name.toLowerCase()}`));
      text.append(el('span', 'booking-doc-spec', doc ? info?.specialty || chosenSpec.name : 'Ближайшее свободное время'));
      const back = el('button', 'link-btn', doc ? 'Выбрать другого врача' : 'Выбрать врача');
      back.type = 'button';
      back.addEventListener('click', () => { show('pick'); say(''); step('pick').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      who.append(pic, text, back);
      // several specialties: which one to book for
      specChips.replaceChildren();
      specChips.hidden = specs.length < 2;
      if (specs.length > 1) for (const s of specs) {
        const b = el('button', 'booking-chip', s.name);
        b.type = 'button';
        b.setAttribute('aria-pressed', String(s.id === chosenSpec.id));
        b.addEventListener('click', () => open(doc, s));
        specChips.append(b);
      }
      show('when');
      step('when').scrollIntoView({ behavior: 'smooth', block: 'start' });
      await loadSlots();
    }

    async function loadSlots() {
      if (!current) return;
      slot = null;
      week.replaceChildren();
      times.replaceChildren();
      dayName.textContent = '';
      range.textContent = 'Загружаем свободное время…';
      empty.hidden = true;
      clinicChips.hidden = true;
      step('patient').hidden = true;
      try {
        if (current.any) {
          slots = await get<Slot[]>('nearest', { spec: current.spec.id });
          clinicNames = Object.fromEntries(slots.map((s) => [s.clinic, s.clinicName || '']));
        } else {
          const [deps, free] = await Promise.all([
            get<{ id: string; name: string }[]>('clinics', { spec: current.spec.id, doctor: current.doc!.id }),
            get<Slot[]>('slots', { spec: current.spec.id, doctor: current.doc!.id }),
          ]);
          clinicNames = Object.fromEntries(deps.map((c) => [c.id, c.name]));
          slots = free.filter((s) => clinicNames[s.clinic] !== undefined || !deps.length);
        }
      } catch (e) {
        range.textContent = '';
        return fail(e);
      }
      // clinics: start with the one that has the earliest free time
      const ids = [...new Set(slots.map((s) => s.clinic))];
      clinic = slots[0]?.clinic ?? '';
      clinicChips.replaceChildren();
      clinicChips.hidden = ids.length < 2;
      if (ids.length > 1) for (const id of ids) {
        const b = el('button', 'booking-chip', clinicNames[id] || 'Клиника');
        b.type = 'button';
        b.dataset.id = id;
        b.addEventListener('click', () => { clinic = id; firstWeek(); });
        clinicChips.append(b);
      }
      firstWeek();
    }

    const inClinic = () => slots.filter((s) => !clinic || s.clinic === clinic);
    function firstWeek() {
      clinicChips.querySelectorAll<HTMLElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.id === clinic)));
      const list = inClinic();
      if (!list.length) {
        range.textContent = '';
        empty.hidden = false;
        empty.innerHTML = `Свободного времени на ближайший месяц нет. Позвоните ${phone}: администратор предложит варианты.`;
        weekArrows.forEach((a) => (a.hidden = true));
        return;
      }
      weekArrows.forEach((a) => (a.hidden = false));
      selectedDay = split(list[0].start).day;
      weekStart = monday(toDate(selectedDay));
      drawWeek();
    }

    function drawWeek() {
      const list = inClinic();
      const byDay = new Map<string, Slot[]>();
      for (const s of list) { const d = split(s.start).day; byDay.set(d, [...(byDay.get(d) || []), s]); }
      const end = addDays(weekStart, 6);
      range.textContent = weekStart.getMonth() === end.getMonth()
        ? `${weekStart.getDate()} – ${fmt(end, { day: 'numeric', month: 'long' })}`
        : `${fmt(weekStart, { day: 'numeric', month: 'long' })} – ${fmt(end, { day: 'numeric', month: 'long' })}`;
      const last = list.length ? toDate(split(list[list.length - 1].start).day) : weekStart;
      weekArrows[0].disabled = weekStart <= monday(new Date());
      weekArrows[1].disabled = addDays(weekStart, 7) > last;
      week.replaceChildren();
      for (let i = 0; i < 7; i++) {
        const date = addDays(weekStart, i);
        const k = dayKey(date);
        const has = byDay.has(k);
        const b = el('button', 'booking-day');
        b.type = 'button';
        b.setAttribute('role', 'tab');
        b.disabled = !has;
        b.setAttribute('aria-selected', String(k === selectedDay));
        b.setAttribute('aria-label', cap(fmt(date, { weekday: 'long', day: 'numeric', month: 'long' })) + (has ? '' : ', нет свободного времени'));
        b.append(
          el('span', 'booking-day-wd', fmt(date, { weekday: 'short' })),
          el('span', 'booking-day-n', String(date.getDate())),
          el('span', 'booking-day-m', fmt(date, { month: 'short' }).replace('.', '')),
        );
        b.addEventListener('click', () => { selectedDay = k; drawWeek(); });
        week.append(b);
      }
      // the chosen day is in this week and has time, or take the week's first day with time
      const inWeek = [...byDay.keys()].filter((k) => { const d = toDate(k); return d >= weekStart && d <= end; });
      if (!inWeek.includes(selectedDay)) {
        selectedDay = inWeek[0] ?? '';
        week.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-selected', String(dayKey(addDays(weekStart, i)) === selectedDay)));
      }
      drawTimes(byDay.get(selectedDay) || []);
    }
    weekArrows.forEach((a) => a.addEventListener('click', () => { weekStart = addDays(weekStart, Number(a.dataset.week) * 7); drawWeek(); }));

    function drawTimes(list: Slot[]) {
      times.replaceChildren();
      times.classList.toggle('with-names', !!current?.any);
      if (!list.length) {
        dayName.textContent = 'На этой неделе свободного времени нет';
        return;
      }
      dayName.textContent = cap(fmt(toDate(selectedDay), { weekday: 'long', day: 'numeric', month: 'long' }));
      for (const s of list) {
        const b = el('button', 'booking-time');
        b.type = 'button';
        b.append(el('span', '', split(s.start).time));
        if (current?.any && s.doctorName) b.append(el('small', '', s.doctorName.split(' ')[0]));
        b.classList.toggle('is-active', slot?.id === s.id);
        b.addEventListener('click', () => choose(s));
        times.append(b);
      }
    }

    // ================= 3. patient =================
    function choose(s: Slot) {
      slot = s;
      drawTimes(inClinic().filter((x) => split(x.start).day === selectedDay));
      const name = current?.any ? s.doctorName || '' : current?.doc?.name || '';
      const { day, time } = split(s.start);
      const strong = el('strong', '', name);
      chosen.replaceChildren(strong, `, ${current!.spec.name.toLowerCase()}`, el('br'), `${cap(fmt(toDate(day), { weekday: 'long', day: 'numeric', month: 'long' }))}, ${time}`, el('br'), clinicNames[s.clinic] || s.clinicName || '');
      step('patient').hidden = false;
      say('');
      if (!captchaId) newCaptcha();
      step('patient').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    async function newCaptcha() {
      try {
        const c = await get<{ id: string; svg: string }>('captcha');
        captchaId = c.id;
        // The МИС sends the picture as SVG markup: shown as an image, so nothing in it runs
        const img = new Image();
        img.alt = '';
        img.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(c.svg)}`;
        captchaImg.replaceChildren(img);
        $<HTMLInputElement>('[name=captchaValue]').value = '';
      } catch (e) { fail(e); }
    }
    $('[data-new-captcha]').addEventListener('click', newCaptcha);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!slot) return say('Выберите время приёма.');
      const f = new FormData(form);
      const v = (k: string) => String(f.get(k) || '').trim();
      if (!v('surname') || !v('firstName')) return say('Укажите фамилию и имя.');
      if (!v('birthDate')) return say('Укажите дату рождения.');
      if (v('phone').replace(/\D/g, '').length < 10) return say('Проверьте номер телефона.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v('email'))) return say('Проверьте электронную почту.');
      if (!v('captchaValue')) return say('Введите код с картинки.');
      if (!f.get('consent')) return say('Нужно согласие на обработку персональных данных.');
      const button = $<HTMLButtonElement>('button[type=submit]');
      button.disabled = true;
      say('');
      try {
        const res = await fetch(`${api}/book`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slot: slot.id, surname: v('surname'), firstName: v('firstName'), secondName: v('secondName'),
            birthDate: v('birthDate'), phone: v('phone'), email: v('email'), captchaId, captchaValue: v('captchaValue'), consent: true,
          }),
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body.ok) {
          form.querySelectorAll<HTMLElement>('.booking-step').forEach((s) => (s.hidden = true));
          say(`<strong>Вы записаны.</strong><br><span data-booked></span><br>Если планы изменятся, позвоните ${phone}.`, true);
          status.querySelector('[data-booked]')!.replaceChildren(...chosen.cloneNode(true).childNodes);
          status.scrollIntoView({ behavior: 'smooth', block: 'center' });
          (window as any).ym?.(108194831, 'reachGoal', 'online_booking');
          return;
        }
        if (body.code === 'captcha') { await newCaptcha(); return say(esc(String(body.error))); }
        if (body.code === 'taken') { await loadSlots(); return say(esc(String(body.error))); }
        throw new Error(body.error || 'Не получилось записаться.');
      } catch (err) {
        fail(err);
      } finally {
        button.disabled = false;
      }
    });

    // ================= start =================
    (async () => {
      try {
        all = await get<Doc[]>('all');
        if (!all.length) throw new Error('empty');
        const specs = new Map<string, string>();
        all.forEach((d) => d.specs.forEach((s) => specs.set(s.id, s.name)));
        [...specs].sort((a, b) => a[1].localeCompare(b[1], 'ru')).forEach(([id, name]) => specSel.append(new Option(name, id)));
        form.hidden = false;
        renderDocs();
        // from a doctor's page: that doctor straight away
        const url = new URLSearchParams(location.search).get('doctor') || '';
        const info = siteDocs.find((d) => d.url === url);
        const doc = info && all.find((d) => key(d.name) === key(info.name));
        if (doc) open(doc);
      } catch {
        form.remove(); // the phone below is the way to book
      }
    })();
  }
</script>
