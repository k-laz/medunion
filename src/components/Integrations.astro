---
// Metrica, Top.Mail.Ru, Bitrix24 CRM, Callibri call tracking and the messenger widget. They set
// cookies, so under 152-ФЗ they load only after the visitor presses «Принять»
// in the cookie banner (CookieNotice.astro; the choice is kept on the device as
// localStorage 'cookie-consent' = 'all' | 'necessary'). They also load only on
// the production build and only on the real domain: the same build on the
// server's bare IP (for testing) must not count visits or send chats to the
// clinic's operators.
import { integrations, isProduction } from '../data/site';
const { metrikaId, bitrix24, dailyGrowWidgetId, topMailRuId, callibri } = integrations;
---

{isProduction && (
  <>
    <script is:inline define:vars={{ metrikaId, b24: [bitrix24.callTracker, bitrix24.siteButton], dailyGrowWidgetId, topMailRuId, callibri }}>
      var load = function () {
        if (window.__mdLoaded || !/(^|\.)medunion\.group$/.test(location.hostname)) return;
        window.__mdLoaded = true;
        // Yandex Metrica
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
          m[i].l = 1 * new Date();
          k = e.createElement(t); a = e.getElementsByTagName(t)[0];
          k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + metrikaId, 'ym');
        ym(metrikaId, 'init', { webvisor: true, clickmap: true, accurateTrackBounce: true, trackLinks: true });

        var add = function (src) { var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); };
        // Bitrix24: call tracking and the chat / callback button
        b24.forEach(function (u) { add(u + '?' + (Date.now() / 60000 | 0)); });

        // Callibri: tracking phone numbers (Bitrix24 above doesn't swap numbers;
        // only one of the two may, or they fight over the same numbers)
        if (callibri) add(callibri);

        // daily-grow messenger widget (off while dailyGrowWidgetId is empty)
        if (dailyGrowWidgetId) {
          window.dgSocialWidgetData = window.dgSocialWidgetData || [];
          window.dgSocialWidgetData.push({ widgetId: dailyGrowWidgetId, apiUrl: 'https://app.daily-grow.com/sw/api/v1' });
          add('https://app.daily-grow.com/social-widget/init.js');
        }

        // Top.Mail.Ru counter (VK ads)
        var _tmr = window._tmr || (window._tmr = []);
        _tmr.push({ id: topMailRuId, type: 'pageView', start: new Date().getTime() });
        if (!document.getElementById('tmr-code')) { var ts = document.createElement('script'); ts.async = true; ts.id = 'tmr-code'; ts.src = 'https://top-fwz1.mail.ru/js/code.js'; document.head.appendChild(ts); }
      };
      var consent = null;
      try { consent = localStorage.getItem('cookie-consent'); } catch (e) {}
      if (consent === 'all') load();
      document.addEventListener('cookie-consent', function (e) { if (e.detail === 'all') load(); });
    </script>
  </>
)}
