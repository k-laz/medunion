---
// Booking card in the right-hand column: starting price, where, when, book.
// On articles it can name the related service and skip the clinic hours.
import { clinics, type ClinicKey, bookingPage } from '../data/site';
import { rub } from '../lib/content';

interface Props {
  prices?: { name: string; price: number }[];
  clinicKeys?: ClinicKey[];
  service?: { label: string; url: string };
  places?: boolean;
  heading?: string;
  note?: string;
}
const { prices = [], service, places = true, heading, note } = Astro.props;
const clinicKeys = Astro.props.clinicKeys?.length ? Astro.props.clinicKeys : (['kurchatova', 'instrumentalnaya'] as ClinicKey[]);
const from = prices.length ? Math.min(...prices.map((p) => p.price)) : 0;
const phonesShown = [...new Map(clinicKeys.map((k) => [clinics[k].phone.tel, clinics[k].phone])).values()];
---

<aside class="info-card" aria-label="Стоимость и запись">
  {heading && <p class="info-heading">{heading}</p>}
  {service && <a class="info-service" href={service.url}>{service.label}</a>}
  {from > 0 && (
    <p class="info-price"><span>Стоимость</span> от {rub(from)}</p>
  )}
  {places && (
    <ul class="info-places">
      {clinicKeys.map((k) => (
        <li>
          <strong>{clinics[k].city}, {clinics[k].address}</strong>
          <span>{clinics[k].hours.join(' · ')}</span>
        </li>
      ))}
    </ul>
  )}
  {note && <p class="info-note">{note}</p>}
  <div class="info-actions">
    <a class="btn btn-primary btn-wide" href={bookingPage}>Записаться</a>
    {phonesShown.map((p) => <a class="btn btn-quiet btn-wide" href={`tel:${p.tel}`}>{p.display}</a>)}
  </div>
</aside>
