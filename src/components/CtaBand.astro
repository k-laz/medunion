---
import { integrations, phones } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Запишитесь на приём', text = 'Онлайн или по телефону, в удобной для вас клинике.' } = Astro.props;
const bookingUrl = `https://booking.medflex.ru/?user=${integrations.medflexUser}`;
---

<section class="cta-band">
  <div class="cta-band-text">
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="cta-row">
    <a class="btn btn-light" href={bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
    <a class="btn btn-ghost-light" href={`tel:${phones.main.tel}`}>{phones.main.display}</a>
  </div>
</section>
