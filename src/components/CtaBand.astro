---
import { city } from '../data/city';
import { integrations, phones, bookingPage } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Запишитесь на приём', text = 'Онлайн или по телефону, в удобной для вас клинике.' } = Astro.props;
const bookingUrl = bookingPage; // our /appointment/ page
---

<section class="cta-band">
  <div class="cta-band-text">
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="cta-row">
    <a class="btn btn-light" href={bookingUrl}>Записаться</a>
    <a class="btn btn-ghost-light" href={`tel:${city.phone.tel}`}>{city.phone.display}</a>
  </div>
</section>
