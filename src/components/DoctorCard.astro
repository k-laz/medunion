---
import { clinics, type ClinicKey } from '../data/site';
import { initials, years } from '../lib/content';

interface Props {
  name: string;
  specialty: string;
  url: string;
  photo?: string;
  experienceYears?: number;
  clinicKeys: ClinicKey[];
}
const { name, specialty, url, photo, experienceYears, clinicKeys } = Astro.props;
---

<article class="doctor-card">
  <a class:list={["doctor-card-photo", { "no-photo": !photo }]} href={url} tabindex="-1" aria-hidden="true">
    {photo ? <img src={photo} alt="" loading="lazy" /> : <span>{initials(name)}</span>}
  </a>
  <div class="doctor-card-body">
    <h3><a href={url}>{name}</a></h3>
    <p class="doctor-card-spec">{specialty}</p>
    {experienceYears && <p class="doctor-card-meta">Стаж: {years(experienceYears)}</p>}
    {clinicKeys.length > 0 && <p class="doctor-card-meta">{clinicKeys.map((k) => clinics[k].address).join('; ')}</p>}
  </div>
  <a class="btn btn-outline btn-wide" href={url}>Подробнее</a>
</article>
