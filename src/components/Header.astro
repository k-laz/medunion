---
import { phones, integrations, bookingPage } from '../data/site';
import SearchBox from './SearchBox.astro';
const bookingUrl = bookingPage; // our /appointment/ page with the MedFlex booking
const nav = [
  { href: '/uslugi/', label: 'Услуги' },
  { href: '/vrachi/', label: 'Врачи' },
  { href: '/ceny/', label: 'Цены' },
  { href: '/sales/', label: 'Акции' },
  { href: '/articles/', label: 'Статьи' },
  { href: '/contacts/', label: 'Клиники' },
];
const current = Astro.url.pathname;
---

<div class="topbar">
  <div class="wrap topbar-row">
    <nav class="topbar-cities" aria-label="Города">
      <a href="/contacts/">Красноярск</a>
      <a href="/contacts/klinika-v-kanske/">Канск</a>
    </nav>
    <button class="topbar-link" type="button" data-a11y-toggle aria-pressed="false">
      <svg width="20" height="12" viewBox="0 0 30 16" aria-hidden="true"><circle cx="7" cy="9" r="5.5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="23" cy="9" r="5.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12.5 8.5c1.5-1.4 3.5-1.4 5 0" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      <span>Версия для слабовидящих</span>
    </button>
    <a class="topbar-phone" href={`tel:${phones.main.tel}`}>{phones.main.display}</a>
  </div>
</div>

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label="Медюнион, на главную">
      <svg class="brand-mark" width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
        <rect width="36" height="36" rx="11" fill="currentColor" />
        <path d="M18 9v18M9 18h18" stroke="#fff" stroke-width="5" stroke-linecap="round" />
      </svg>
      <span class="brand-text">
        <span class="brand-name">Медюнион</span>
        <span class="brand-sub">сеть медицинских центров</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Основное меню">
      {nav.map((item) => <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>

    <div class="header-tools">
      <button class="icon-btn" type="button" data-search-toggle aria-expanded="false" aria-controls="header-search" aria-label="Поиск">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <a class="btn btn-primary header-book" href={bookingUrl}>Записаться</a>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-panel" aria-label="Меню">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>

  <div class="header-search" id="header-search" hidden>
    <div class="wrap"><SearchBox id="q-header" /></div>
  </div>
</header>

<div class="menu-panel" id="menu-panel" hidden>
  <div class="menu-sheet">
    <button class="icon-btn menu-close" type="button" data-menu-toggle aria-label="Закрыть меню">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
    <nav aria-label="Меню">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/company/">О компании</a>
      <a href="/pacientam/obsluzhivanie-oms-dms/">ОМС и ДМС</a>
    </nav>
    <div class="menu-contacts">
      <a class="btn btn-primary btn-wide" href={bookingUrl}>Записаться на приём</a>
      <a class="btn btn-quiet btn-wide" href={`tel:${phones.main.tel}`}>{phones.main.display}</a>
      <button class="topbar-link" type="button" data-a11y-toggle aria-pressed="false">Версия для слабовидящих</button>
    </div>
  </div>
</div>

<div class="mobile-bar" role="navigation" aria-label="Быстрые действия">
  <a class="btn btn-quiet" href={`tel:${phones.main.tel}`}>Позвонить</a>
  <a class="btn btn-primary" href={bookingUrl}>Записаться</a>
</div>

<script>
  // Search drop-down under the header
  const searchBtn = document.querySelector<HTMLButtonElement>('[data-search-toggle]')!;
  const searchRow = document.getElementById('header-search')!;
  searchBtn.addEventListener('click', () => {
    const open = searchRow.hidden;
    searchRow.hidden = !open;
    searchBtn.setAttribute('aria-expanded', String(open));
    if (open) searchRow.querySelector('input')?.focus();
  });

  // Slide-in menu
  const panel = document.getElementById('menu-panel')!;
  const setMenu = (open: boolean) => {
    panel.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
    document.querySelectorAll('[data-menu-toggle]').forEach((b) => b.setAttribute('aria-expanded', String(open)));
  };
  document.querySelectorAll('[data-menu-toggle]').forEach((b) => b.addEventListener('click', () => setMenu(panel.hidden)));
  panel.addEventListener('click', (e) => { if (e.target === panel) setMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) setMenu(false); });

  // Large text, high contrast version. Remembered on this device.
  const root = document.documentElement;
  const sync = () => document.querySelectorAll('[data-a11y-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(root.classList.contains('a11y'))));
  sync();
  document.querySelectorAll('[data-a11y-toggle]').forEach((b) =>
    b.addEventListener('click', () => {
      const on = root.classList.toggle('a11y');
      try { localStorage.setItem('a11y', on ? '1' : ''); } catch {}
      sync();
    }),
  );
</script>
