---
import { clinics, integrations, type ClinicKey } from '../data/site';
import { rub } from '../lib/content';

interface Props {
  prices?: { name: string; price: number }[];
  clinicKeys?: ClinicKey[];
  checkedOn?: Date;
}
const { prices = [], checkedOn } = Astro.props;
// No clinic given: show both Krasnoyarsk clinics.
const clinicKeys = Astro.props.clinicKeys?.length ? Astro.props.clinicKeys : (['kurchatova', 'instrumentalnaya'] as ClinicKey[]);
const bookingUrl = `https://booking.medflex.ru/?user=${integrations.medflexUser}`;
const places = clinicKeys.map((k) => clinics[k]);
const phonesShown = [...new Map(places.map((c) => [c.phone.tel, c.phone])).values()];
const checkedText = checkedOn?.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<aside class="booking" aria-label="Цены и запись">
  {prices.length > 0 && (
    <dl class="price-list">
      {prices.slice(0, 8).map((p) => (
        <div class="price-row">
          <dt class="price-name">{p.name}</dt>
          <span class="price-dots" aria-hidden="true"></span>
          <dd class="price-value">{rub(p.price)}</dd>
        </div>
      ))}
    </dl>
  )}

  <div class="booking-places">
    {places.map((c) => (
      <div class="booking-place">
        <p class="booking-address">{c.city}, {c.address}</p>
        <p class="muted">{c.hours.join(', ')}</p>
      </div>
    ))}
  </div>

  <div class="booking-actions">
    <a class="btn btn-primary btn-wide" href={bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
    {phonesShown.map((p) => <a class="btn btn-quiet btn-wide" href={`tel:${p.tel}`}>{p.display}</a>)}
  </div>

  {checkedText && <p class="booking-note">Цены на {checkedText}. Не является публичной офертой.</p>}
  {!checkedText && prices.length > 0 && <p class="booking-note">Не является публичной офертой. Точную стоимость уточняйте при записи.</p>}
</aside>
