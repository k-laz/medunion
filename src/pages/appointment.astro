---
// Online booking. Same address as on the old site (/appointment/), which
// every old page, ad and bookmark links to.
// The booking itself is MedFlex, connected to the clinic's medical
// information system (МИС), so appointments land straight in the schedule.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { clinics, medflexUrl as bookingUrl, phones } from '../data/site';
---

<Base
  title="Запись на приём онлайн | Медюнион"
  description="Онлайн-запись к врачу и на диагностику в Медюнион: выберите специалиста, клинику и удобное время. Красноярск и Канск. Телефон +7 (391) 220-03-03."
  url="/appointment/"
>
  <PageHead url="/appointment/" h1="Запись на приём" lead="Выберите врача или услугу, клинику и удобное время. Запись сразу попадает в расписание клиники." compact />

  <div class="wrap page-body booking-page">
    <div class="booking-frame">
      <iframe src={bookingUrl} title="Онлайн-запись Медюнион" loading="eager" allow="clipboard-write"></iframe>
      <p class="booking-fallback">Окно записи не открылось? <a href={bookingUrl} target="_blank" rel="noopener">Открыть запись в новой вкладке</a></p>
    </div>

    <aside class="booking-side">
      <section class="info-card">
        <p class="info-price"><span>Запись по телефону</span><a href={`tel:${phones.main.tel}`}>{phones.main.display}</a></p>
        <ul class="info-places">
          {Object.values(clinics).map((c) => (
            <li>
              <strong>{c.city}, {c.address}</strong>
              <span>{c.hours.join(' · ')}</span>
              {c.phone.tel !== phones.main.tel && <a href={`tel:${c.phone.tel}`}>{c.phone.display}</a>}
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</Base>
