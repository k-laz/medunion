---
import { city } from '../data/city';
// Booking. Same address as on the old site (/appointment/), which every old
// page, ad and bookmark links to.
//
// With bookingFormOn the online form comes first (the МИС through our own
// server, deploy/api/server.mjs); the phone stays below it in any case, and is
// all there is while the form is off or the server can't be reached.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import BookingForm from '../components/BookingForm.astro';
import { clinics, bookingFormOn } from '../data/site';
---

<Base
  title="Запись на приём | Медюнион"
  description="Запись к врачу и на диагностику в Медюнион, Красноярск и Канск. Позвоните +7 (391) 220-03-03: администратор подберёт врача, клинику и удобное время."
  url="/appointment/"
>
  <PageHead url="/appointment/" h1="Запись на приём" lead={bookingFormOn ? 'Выберите врача и свободное время онлайн или позвоните нам: администратор подберёт врача, ответит на вопросы о подготовке и ценах.' : 'Позвоните нам: администратор подберёт врача и удобное время, ответит на вопросы о подготовке и ценах.'} compact />

  <div class="wrap page-body booking-page">
    {bookingFormOn && <BookingForm />}
    <section class="booking-main info-card">
      <p class="info-price"><span>Единый номер для записи</span><a href={`tel:${city.phone.tel}`}>{city.phone.display}</a></p>
      <a class="btn btn-primary booking-call" href={`tel:${city.phone.tel}`}>Позвонить</a>
      <p class="booking-note">Если не можете говорить, напишите нам в мессенджер через кнопку в углу экрана.</p>
    </section>

    <ul class="booking-clinics">
      {Object.values(clinics).map((c) => (
        <li class="info-card">
          <h2>{c.city}, {c.address}</h2>
          <ul class="booking-hours">{c.hours.map((h) => <li>{h}</li>)}</ul>
          <a href={`tel:${c.phone.tel}`}>{c.phone.display}</a>
        </li>
      ))}
    </ul>
  </div>
</Base>
