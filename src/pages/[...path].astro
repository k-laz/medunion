---
// One route builds every content page at the exact address it had on the
// old Bitrix site (the `url` field in each Markdown file).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ServicePage from '../templates/ServicePage.astro';
import DoctorPage from '../templates/DoctorPage.astro';
import ArticlePage from '../templates/ArticlePage.astro';
import PricesPage from '../templates/PricesPage.astro';
import ListingPage from '../templates/ListingPage.astro';
import ContactsPage from '../templates/ContactsPage.astro';
import { clinics } from '../data/site';

export async function getStaticPaths() {
  const strip = (u: string) => decodeURI(u).replace(/^\/|\/$/g, '');
  const kinds = ['services', 'doctors', 'articles', 'prices', 'listings', 'pages'] as const;
  const seen = new Map<string, string>();
  const paths = [];
  for (const kind of kinds) {
    for (const entry of await getCollection(kind)) {
      const url = entry.data.url;
      if (url === '/') continue; // the home page has its own file
      if (seen.has(url)) throw new Error(`Two files claim ${url}: ${seen.get(url)} and ${kind}/${entry.id}`);
      seen.set(url, `${kind}/${entry.id}`);
      paths.push({ params: { path: strip(url) }, props: { kind, entry } });
    }
  }
  return paths;
}

const { kind, entry } = Astro.props as { kind: string; entry: any };
const d = entry.data;

const site = Astro.site!;
const jsonLd =
  kind === 'doctors'
    ? { '@context': 'https://schema.org', '@type': 'Physician', name: d.name, medicalSpecialty: d.specialty, url: new URL(d.url, site).href }
    : kind === 'services'
      ? {
          '@context': 'https://schema.org',
          '@type': 'MedicalClinic',
          name: 'Медюнион',
          url: new URL(d.url, site).href,
          address: (d.clinics.length ? d.clinics : ['kurchatova', 'instrumentalnaya']).map((k: keyof typeof clinics) => ({
            '@type': 'PostalAddress', addressLocality: clinics[k].city, streetAddress: clinics[k].address, addressCountry: 'RU',
          })),
        }
      : null;
---

<Base title={d.title} description={d.description} url={d.url}>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {kind === 'services' && <ServicePage entry={entry} />}
  {kind === 'doctors' && <DoctorPage entry={entry} />}
  {kind === 'articles' && <ArticlePage entry={entry} />}
  {kind === 'prices' && <PricesPage entry={entry} />}
  {kind === 'listings' && <ListingPage entry={entry} />}
  {kind === 'pages' && (d.layout ? <ContactsPage entry={entry} /> : <ArticlePage entry={entry} />)}
</Base>
