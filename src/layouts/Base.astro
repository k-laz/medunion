---
import '@fontsource/golos-text/cyrillic-400.css';
import '@fontsource/golos-text/cyrillic-500.css';
import '@fontsource/golos-text/cyrillic-600.css';
import '@fontsource/golos-text/latin-400.css';
import '@fontsource/golos-text/latin-600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Integrations from '../components/Integrations.astro';
import CookieNotice from '../components/CookieNotice.astro';
import { isProduction, integrations } from '../data/site';

interface Props {
  title: string;
  description: string;
  url: string; // path on the site, e.g. "/uslugi/"
  noindex?: boolean;
}
const { title, description, url, noindex = false } = Astro.props;
const canonical = new URL(url, Astro.site).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!isProduction || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {integrations.yandexVerification && <meta name="yandex-verification" content={integrations.yandexVerification} />}
    <meta name="theme-color" content="#2f55d4" />
    <script is:inline>try { if (localStorage.getItem('a11y')) document.documentElement.classList.add('a11y'); } catch (e) {}</script>
  </head>
  <body>
    <a class="skip" href="#main">Перейти к содержанию</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieNotice />
    <Integrations />
  </body>
</html>
