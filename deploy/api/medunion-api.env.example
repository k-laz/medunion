# Settings of the booking API. On the server this file is /etc/medunion-api.env
# (owner root, mode 600). Fill it in on the server only, never in the repository.
#
# The МИС address, as in the old site's ApiMIS.php ($baseUrl), without a slash at the end
MIS_BASE_URL=
# The МИС «API Личный кабинет» token ($apiToken). Ask Решение for a new one:
# the old one is known to Conversite.
MIS_API_TOKEN=
# Birth dates for the МИС: iso (1990-12-31, what it takes) or ru (31.12.1990)
MIS_BIRTHDATE_FORMAT=iso
# How many days ahead to show free time
BOOKING_DAYS=31
PORT=8787
